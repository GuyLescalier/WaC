{
  "$schema": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3/resource/manifest.json",
  "type": "MyCompany.Installer/MyCertificate",
  "version": "0.0.1",
  "description": "Installs or removes a certificate",
  "get": {
    "executable": "pwsh",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-File",
      "./MyCertificate.ps1",
      "Get"
    ],
    "input": "stdin"
  },
  "set": {
    "executable": "pwsh",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-File",
      "./MyCertificate.ps1",
      "Set"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "pwsh",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-File",
      "./MyCertificate.ps1",
      "Test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string",
          "description": "Resource identifier",
          "default": "MyCertificate",
          "key": true
        },
        "ensure": {
          "type": "string",
          "enum": ["Present", "Absent"],
          "description": "Whether the Certificate should be installed or removed",
          "default": "Present"
        },
        "storeName": {
          "type": "string",
          "default": "Root",
          "description": "Certificate store name."
        },
        "location": {
          "type": "string",
          "default": "LocalMachine",
          "description": "Certificate store location."
        }
      }
    }
  }
}
